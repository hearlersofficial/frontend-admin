{
  "name": "frontend-admin",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "remix vite:build",
    "dev": "remix vite:dev",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "remix-serve ./build/server/index.js",
    "typecheck": "tsc",
    "sta": "sta generate -p https://dev.api.hearlers.com/v3/api-docs -o app/__generated__ --modular --axios --extract-request-params --extract-request-body --extract-response-body --extract-response-error"
  },
